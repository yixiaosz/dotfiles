# Theme
theme = Material Darker
# theme = Flexoki Light

# Font settings
font-family = "TX-02"
font-size = 18

# Window behavior
window-theme = auto
window-decoration = true
confirm-close-surface = false
window-height = 30
window-width = 100
window-padding-x = 10
window-padding-y = 10

# Mouse & interaction
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1

# Cursor settings
# cursor-style = block

# Platform-specific overrides
# Make sure that ~/.config/ghostty has 1) config 2) config.[OS]
# config.linux: font-size 14, tmux auto-attach command
# config.macos: font-size 18, custom ghostty icon
config-file = ?config.linux
config-file = ?config.macos
